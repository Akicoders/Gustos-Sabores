---
import Layout from '../layouts/Layout.astro';
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000/api';
---

<Layout title="Promociones | Gustos y Sabores">
  <section class="promos-page page" data-api={apiUrl}>
    <span class="eyebrow">PROMOCIONES</span>
    <h1>Combos para compartir</h1>
    <p>Promociones activas del restaurante. Agrega una promoción al carrito y continúa el pago.</p>

    <div class="promo-grid">
      <article class="promo-card" data-dish-name="Arroz con pato" data-promo-name="Combo Norteño">
        <img src="https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=900&q=80" alt="Combo norteño" />
        <div>
          <h2>Combo Norteño</h2>
          <p>Arroz con pato + bebida tradicional.</p>
          <strong>S/ 58.00</strong>
          <button type="button">Agregar promoción</button>
        </div>
      </article>

      <article class="promo-card" data-dish-name="Lomo saltado" data-promo-name="Lomo para dos">
        <img src="https://images.unsplash.com/photo-1529692236671-f1f6cf9683ba?auto=format&fit=crop&w=900&q=80" alt="Lomo para dos" />
        <div>
          <h2>Lomo para dos</h2>
          <p>Lomo saltado familiar con refresco.</p>
          <strong>S/ 52.00</strong>
          <button type="button">Agregar promoción</button>
        </div>
      </article>

      <article class="promo-card" data-dish-name="Ceviche clasico" data-promo-name="Ceviche y chicha">
        <img src="https://images.unsplash.com/photo-1626200419199-391ae4be7a41?auto=format&fit=crop&w=900&q=80" alt="Ceviche y chicha" />
        <div>
          <h2>Ceviche y chicha</h2>
          <p>Ceviche clásico + chicha morada.</p>
          <strong>S/ 48.00</strong>
          <button type="button">Agregar promoción</button>
        </div>
      </article>
    </div>

    <p id="promo-status" class="status"></p>
    <a class="button" href="/pedidos">Ir al pago</a>
  </section>
</Layout>

<script>
  const CART_KEY = 'gustos_cart';
  const status = document.querySelector('#promo-status');
  const api = document.querySelector('.promos-page').dataset.api;
  let dishes = [];

  function getCart() {
    try { return JSON.parse(localStorage.getItem(CART_KEY) || '[]'); } catch { return []; }
  }

  function saveCart(cart) {
    localStorage.setItem(CART_KEY, JSON.stringify(cart));
  }

  async function loadDishes() {
    const response = await fetch(`${api}/menu/dishes/`);
    dishes = await response.json();
  }

  document.querySelectorAll('[data-dish-name] button').forEach((button) => {
    button.addEventListener('click', () => {
      const card = button.closest('[data-dish-name]');
      const dish = dishes.find((item) => item.name === card.dataset.dishName);
      if (!dish) {
        status.textContent = 'No se pudo encontrar el plato de esta promoción en la API.';
        return;
      }
      const promo = {
        id: dish.id,
        name: card.dataset.promoName,
        price: Number(dish.price),
        quantity: 1,
        image_url: dish.image_url,
      };
      const cart = getCart();
      const existing = cart.find((item) => item.id === promo.id);
      if (existing) existing.quantity += 1;
      else cart.push(promo);
      saveCart(cart);
      status.textContent = `${promo.name} agregado al carrito.`;
    });
  });

  loadDishes().catch(() => {
    status.textContent = 'No se pudo cargar el menú para promociones.';
  });
</script>

<style>
  .promos-page { text-align: center; }
  .promos-page > p { max-width: 620px; margin-inline: auto; }

  .promo-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 2rem 0;
    text-align: left;
  }

  .promo-card {
    display: grid;
    overflow: hidden;
    background: white;
    border: 1px solid var(--line);
    box-shadow: 0 18px 55px rgba(0, 63, 53, 0.1);
  }

  .promo-card img {
    width: 100%;
    height: 190px;
    object-fit: cover;
  }

  .promo-card div {
    display: grid;
    gap: 0.7rem;
    padding: 1rem;
  }

  .promo-card h2 { color: var(--jade); font-size: 1.45rem; }
  .promo-card p { margin: 0; }
  .promo-card strong { color: var(--jade-2); font-size: 1.35rem; }
  .promo-card button { border-radius: 0; }

  @media (max-width: 850px) {
    .promo-grid { grid-template-columns: 1fr; }
  }
</style>
