# ============================================================
# GUSTOS Y SABORES — Frontend (Vercel)
# ============================================================
# Copiá este archivo: cp .env.example .env
#
# Para desarrollo local el frontend levanta en http://localhost:4321
# y consume la API en http://localhost:8000/api.
#
# En Vercel, configurá PUBLIC_API_URL en:
#   Settings → Environment Variables → Production
# ============================================================

# URL de la API REST del backend.
# En local apunta al runserver de Django.
# En Vercel debe apuntar a tu backend desplegado en producción.
PUBLIC_API_URL=http://localhost:8000/api
