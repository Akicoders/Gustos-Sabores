---
const { title = 'Gustos y Sabores' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sistema web MVP para pedidos y reservas del restaurante Gustos y Sabores." />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="social-strip" aria-label="Redes sociales">f · ◎ · x</div>
      <a class="brand" href="/">Gustos y Sabores</a>
      <nav aria-label="Navegacion principal">
        <a href="/acerca">ACERCA DE</a>
        <a href="/reservas">CONTACTO</a>
        <a href="/menu">MENÚ</a>
        <a href="/promociones">PROMOCIONES</a>
        <a href="/reclamaciones">RECLAMACIONES</a>
        <a href="/transparencia">TRANSPARENCIA</a>
      </nav>
      <a class="account-chip" href="/admin" aria-label="Panel Administrativo">●⌄</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>Gustos y Sabores</strong>
        <p>Cocina autentica tradicional</p>
      </div>
      <div>
        <strong>Conoce mas</strong>
        <p>Quienes somos · Trabaja con nosotros</p>
      </div>
      <div>
        <strong>Redes Sociales</strong>
        <p>Facebook · Instagram · X</p>
      </div>
    </footer>

    <script>
      import { revealOnScroll } from '../scripts/dom';
      revealOnScroll();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #062c28;
    --ink-soft: #4e6862;
    --cream: #f7f3e9;
    --paper: #fffdf6;
    --jade: #003f35;
    --jade-2: #005648;
    --jade-3: #00725f;
    --accent: #e3962e;
    --clay: #ac3c24;
    --line: rgba(0, 63, 53, 0.16);
    --frame-width: 1120px;
    font-family: 'Trebuchet MS', ui-sans-serif, system-ui, sans-serif;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    color: var(--ink);
    background:
      repeating-linear-gradient(90deg, transparent 0 18px, rgba(0, 114, 95, 0.18) 18px 20px, transparent 20px 36px),
      linear-gradient(90deg, #ffffff 0 10%, var(--paper) 10% 90%, #ffffff 90% 100%);
  }

  body::before,
  body::after {
    content: '';
    position: fixed;
    top: 0;
    bottom: 0;
    z-index: -1;
    width: clamp(26px, 4vw, 52px);
    background:
      radial-gradient(circle, var(--jade-3) 2px, transparent 3px) 0 0 / 14px 24px,
      linear-gradient(var(--jade-3), var(--jade-3)) center / 2px 100% no-repeat;
    opacity: 0.5;
  }

  body::before { left: max(0.75rem, calc((100vw - var(--frame-width)) / 2 - 86px)); }
  body::after { right: max(0.75rem, calc((100vw - var(--frame-width)) / 2 - 86px)); }

  a { color: inherit; text-decoration: none; }

  .site-header {
    position: relative;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(var(--frame-width), calc(100% - 2rem));
    min-height: 138px;
    margin: 0 auto;
    padding: 1.1rem clamp(1rem, 3vw, 2.4rem);
    color: white;
    background: var(--jade);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .brand {
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    font-weight: 800;
    letter-spacing: 0.01em;
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    text-align: center;
    transform: translateY(-0.85rem);
    white-space: nowrap;
  }

  .social-strip,
  .account-chip {
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.95rem;
    letter-spacing: 0.35em;
  }

  .account-chip {
    justify-self: end;
    letter-spacing: 0.12em;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.2rem;
    position: absolute;
    left: 50%;
    bottom: 2rem;
    transform: translateX(-50%);
    max-width: 90%;
  }

  nav a {
    position: relative;
    padding: 0.35rem 0.1rem;
    border: 0;
    border-radius: 0;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.85);
    transition: color 0.18s ease;
    white-space: nowrap;
  }

  nav a::after {
    content: '';
    position: absolute;
    left: 0.45rem;
    right: 0.45rem;
    bottom: 0.1rem;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s ease;
  }

  nav a:hover { color: #ffffff; }
  nav a:hover::after { transform: scaleX(1); }

  main {
    width: min(var(--frame-width), calc(100% - 2rem));
    min-height: calc(100vh - 80px);
    margin: 0 auto;
    background: var(--paper);
    box-shadow: 0 24px 80px rgba(0, 63, 53, 0.08);
  }

  .site-footer {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 1rem;
    padding: 2rem clamp(1rem, 4vw, 4rem);
    color: rgba(255, 255, 255, 0.88);
    width: min(var(--frame-width), calc(100% - 2rem));
    margin: 0 auto;
    background: var(--jade);
    font-family: ui-sans-serif, system-ui, sans-serif;
  }

  .site-footer p {
    margin: 0.35rem 0 0;
    color: rgba(255, 255, 255, 0.66);
  }

  .page {
    width: min(960px, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 5rem) 0;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }

  .eyebrow {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 1rem;
    padding: 0.45rem 0.7rem;
    color: var(--jade);
    background: rgba(0, 86, 72, 0.12);
    border: 1px solid rgba(0, 63, 53, 0.14);
    border-radius: 999px;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1, h2, h3 { margin: 0; line-height: 1.04; text-transform: uppercase; }
  h1 { font-size: clamp(2.6rem, 6vw, 4.8rem); letter-spacing: -0.04em; }
  h2 { font-size: clamp(1.8rem, 4vw, 3rem); letter-spacing: -0.03em; }
  h3 { font-size: 1.15rem; }

  p {
    color: var(--ink-soft);
    font-family: ui-sans-serif, system-ui, sans-serif;
    line-height: 1.7;
  }

  .actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.5rem; }

  .button, button {
    border: 0;
    border-radius: 999px;
    padding: 0.85rem 1.15rem;
    color: white;
    background: linear-gradient(135deg, var(--jade), var(--jade-2));
    box-shadow: 0 18px 35px rgba(0, 63, 53, 0.22);
    cursor: pointer;
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-weight: 800;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease, filter 0.18s ease;
  }

  .button:hover, button:hover {
    transform: translateY(-2px);
    box-shadow: 0 22px 44px rgba(0, 63, 53, 0.28);
    filter: brightness(1.04);
  }

  .button:active, button:active { transform: translateY(0); box-shadow: 0 10px 22px rgba(0, 63, 53, 0.22); }

  button:disabled, .button[aria-disabled='true'] {
    opacity: 0.55;
    cursor: not-allowed;
    transform: none;
    filter: none;
  }

  :focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  .button.secondary { color: var(--jade); background: white; }

  .panel, .card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 28px;
    box-shadow: 0 24px 80px rgba(23, 63, 52, 0.1);
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 30px 90px rgba(23, 63, 52, 0.16);
  }

  .panel { padding: clamp(1.2rem, 3vw, 2rem); }

  .feature-grid, .menu-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .card { padding: 1.2rem; }

  .price { color: var(--jade-2); font-size: 1.4rem; font-weight: 900; }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  label {
    display: grid;
    gap: 0.35rem;
    color: var(--ink-soft);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
  }

  input, select, textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 0.85rem 1rem;
    color: var(--ink);
    background: white;
    font: inherit;
  }

  textarea { min-height: 110px; resize: vertical; }
  .full { grid-column: 1 / -1; }
  .status { margin-top: 1rem; font-weight: 800; }

  /* ---- Animation system ---- */
  html { scroll-behavior: smooth; }

  main > section { scroll-margin-top: 1.5rem; }

  /* Scroll-reveal: elements tagged [data-reveal] fade + slide up when visible */
  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    will-change: opacity, transform;
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  /* Stagger children inside a [data-reveal-group] for a cascading entrance */
  [data-reveal-group].is-visible > *,
  [data-reveal-group] > [data-reveal] { transition-delay: var(--reveal-delay, 0s); }
  [data-reveal-group] > *:nth-child(1) { --reveal-delay: 0s; }
  [data-reveal-group] > *:nth-child(2) { --reveal-delay: 0.06s; }
  [data-reveal-group] > *:nth-child(3) { --reveal-delay: 0.12s; }
  [data-reveal-group] > *:nth-child(4) { --reveal-delay: 0.18s; }
  [data-reveal-group] > *:nth-child(5) { --reveal-delay: 0.24s; }
  [data-reveal-group] > *:nth-child(6) { --reveal-delay: 0.3s; }

  /* Acknowledge actions (e.g. add-to-cart) with a quick pulse */
  @keyframes gs-pulse {
    0% { transform: scale(1); }
    40% { transform: scale(1.12); }
    100% { transform: scale(1); }
  }

  .is-pulsing { animation: gs-pulse 0.32s ease; }

  /* Skeleton placeholders during data fetches */
  @keyframes gs-shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  .skeleton {
    border-radius: 12px;
    background: linear-gradient(90deg, rgba(0, 63, 53, 0.07) 25%, rgba(0, 63, 53, 0.14) 37%, rgba(0, 63, 53, 0.07) 63%);
    background-size: 200% 100%;
    animation: gs-shimmer 1.3s ease-in-out infinite;
  }

  .skeleton-line { height: 0.9rem; margin: 0.4rem 0; }
  .skeleton-card { height: 104px; }

  /* Inline loading spinner */
  @keyframes gs-spin { to { transform: rotate(360deg); } }

  .spinner {
    display: inline-block;
    width: 1.05em;
    height: 1.05em;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    vertical-align: -0.18em;
    animation: gs-spin 0.7s linear infinite;
  }

  .status.is-error { color: var(--clay); }
  .status.is-success { color: var(--jade-2); }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
    }
    [data-reveal] { opacity: 1; transform: none; }
  }

  @media (max-width: 760px) {
    .site-header {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      min-height: auto;
      text-align: center;
    }
    .brand { transform: none; }
    .social-strip, .account-chip { justify-self: center; }
    nav { position: static; transform: none; }
    .site-footer { grid-template-columns: 1fr; }
    .hero, .feature-grid, .menu-grid, .form-grid { grid-template-columns: 1fr; }
    h1 { font-size: clamp(2.7rem, 15vw, 4rem); }
  }
</style>
