---
import AdminLayout from '../../layouts/AdminLayout.astro';
const api = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000/api';
---

<AdminLayout title="Inventario | Gustos y Sabores">
  <div class="section-header">
    <span class="section-title">Control de inventario</span>
    <div style="display:flex;gap:0.5rem">
      <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.85rem;cursor:pointer">
        <input type="checkbox" id="chk-bajo-stock" /> Solo stock bajo
      </label>
      <button class="btn btn-primary" id="btn-nuevo-item">+ Nuevo artículo</button>
    </div>
  </div>

  <div class="admin-card" style="padding:0;overflow:hidden">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Artículo</th>
          <th>Unidad</th>
          <th>Stock actual</th>
          <th>Stock mínimo</th>
          <th>Costo unitario</th>
          <th>Estado</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody id="inv-tbody">
        <tr><td colspan="7" style="text-align:center;padding:2rem;color:var(--ink-soft)">Cargando...</td></tr>
      </tbody>
    </table>
  </div>

  <!-- Modal artículo -->
  <div id="modal-item" class="modal-backdrop" style="display:none">
    <div class="modal">
      <p class="modal-title" id="modal-item-title">Nuevo artículo</p>
      <input type="hidden" id="item-id" />
      <div class="form-row">
        <div class="field">
          <label for="item-name">Nombre</label>
          <input id="item-name" type="text" required />
        </div>
        <div class="field">
          <label for="item-unit">Unidad</label>
          <select id="item-unit">
            <option value="unidad">Unidad</option>
            <option value="kg">Kilogramo</option>
            <option value="g">Gramo</option>
            <option value="l">Litro</option>
            <option value="ml">Mililitro</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="item-min-stock">Stock mínimo</label>
          <input id="item-min-stock" type="number" step="0.001" min="0" value="0" />
        </div>
        <div class="field">
          <label for="item-cost">Costo unitario (S/)</label>
          <input id="item-cost" type="number" step="0.01" min="0" value="0" />
        </div>
      </div>
      <div class="field" style="margin-bottom:1rem">
        <label for="item-notes">Notas</label>
        <textarea id="item-notes"></textarea>
      </div>
      <div id="modal-item-error" class="alert alert-error" style="display:none"></div>
      <div class="modal-actions">
        <button class="btn btn-ghost" id="btn-item-cancel">Cancelar</button>
        <button class="btn btn-primary" id="btn-item-save">Guardar</button>
      </div>
    </div>
  </div>

  <!-- Modal movimiento -->
  <div id="modal-mov" class="modal-backdrop" style="display:none">
    <div class="modal">
      <p class="modal-title">Registrar movimiento de stock</p>
      <input type="hidden" id="mov-item-id" />
      <p id="mov-item-name" style="color:var(--ink-soft);font-size:0.9rem;margin-bottom:1rem"></p>
      <div class="form-row">
        <div class="field">
          <label for="mov-type">Tipo</label>
          <select id="mov-type">
            <option value="in">Entrada</option>
            <option value="out">Salida</option>
            <option value="adjustment">Ajuste (nuevo valor)</option>
          </select>
        </div>
        <div class="field">
          <label for="mov-qty">Cantidad</label>
          <input id="mov-qty" type="number" step="0.001" min="0.001" required />
        </div>
      </div>
      <div class="field" style="margin-bottom:1rem">
        <label for="mov-notes">Referencia / motivo</label>
        <input id="mov-notes" type="text" />
      </div>
      <div id="modal-mov-error" class="alert alert-error" style="display:none"></div>
      <div class="modal-actions">
        <button class="btn btn-ghost" id="btn-mov-cancel">Cancelar</button>
        <button class="btn btn-accent" id="btn-mov-save">Registrar</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ api }}>
  const token = localStorage.getItem('gustos_token');
  let items = [];

  async function cargar(bajoStock = false) {
    const url = bajoStock ? `${api}/inventory/?bajo_stock=1` : `${api}/inventory/`;
    const res = await fetch(url, { headers: { Authorization: `Token ${token}` } });
    items = await res.json();
    render();
  }

  function render() {
    const tbody = document.getElementById('inv-tbody');
    if (!items.length) {
      tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:2rem;color:var(--ink-soft)">Sin artículos</td></tr>';
      return;
    }
    const fmt = new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN' });
    tbody.innerHTML = items.map(it => `<tr>
      <td><strong>${it.name}</strong><br><span style="font-size:0.78rem;color:var(--ink-soft)">${it.notes || ''}</span></td>
      <td>${it.unit}</td>
      <td><strong style="font-size:1rem">${it.stock}</strong></td>
      <td>${it.min_stock}</td>
      <td>${fmt.format(it.cost_price)}</td>
      <td><span class="badge ${it.is_low_stock ? 'badge-low-stock' : 'badge-ok'}">${it.is_low_stock ? 'Stock bajo' : 'OK'}</span></td>
      <td style="display:flex;gap:0.4rem">
        <button class="btn btn-ghost" style="font-size:0.78rem;padding:0.4rem 0.7rem" onclick="editarItem(${it.id})">Editar</button>
        <button class="btn btn-accent" style="font-size:0.78rem;padding:0.4rem 0.7rem" onclick="abrirMovimiento(${it.id},'${it.name}')">Movimiento</button>
      </td>
    </tr>`).join('');
  }

  window.editarItem = function(id) {
    const it = items.find(x => x.id === id);
    document.getElementById('item-id').value = it.id;
    document.getElementById('modal-item-title').textContent = 'Editar artículo';
    document.getElementById('item-name').value = it.name;
    document.getElementById('item-unit').value = it.unit;
    document.getElementById('item-min-stock').value = it.min_stock;
    document.getElementById('item-cost').value = it.cost_price;
    document.getElementById('item-notes').value = it.notes ?? '';
    document.getElementById('modal-item-error').style.display = 'none';
    document.getElementById('modal-item').style.display = 'flex';
  };

  document.getElementById('btn-nuevo-item').onclick = () => {
    document.getElementById('item-id').value = '';
    document.getElementById('modal-item-title').textContent = 'Nuevo artículo';
    ['item-name','item-notes'].forEach(id => document.getElementById(id).value = '');
    document.getElementById('item-min-stock').value = '0';
    document.getElementById('item-cost').value = '0';
    document.getElementById('modal-item-error').style.display = 'none';
    document.getElementById('modal-item').style.display = 'flex';
  };

  document.getElementById('btn-item-cancel').onclick = () => document.getElementById('modal-item').style.display = 'none';

  document.getElementById('btn-item-save').onclick = async () => {
    const id = document.getElementById('item-id').value;
    const errEl = document.getElementById('modal-item-error');
    const body = {
      name: document.getElementById('item-name').value,
      unit: document.getElementById('item-unit').value,
      min_stock: document.getElementById('item-min-stock').value,
      cost_price: document.getElementById('item-cost').value,
      notes: document.getElementById('item-notes').value,
    };
    const url = id ? `${api}/inventory/${id}/` : `${api}/inventory/`;
    const method = id ? 'PUT' : 'POST';
    const res = await fetch(url, {
      method, headers: { Authorization: `Token ${token}`, 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    if (!res.ok) { const err = await res.json(); errEl.textContent = JSON.stringify(err); errEl.style.display = 'block'; return; }
    document.getElementById('modal-item').style.display = 'none';
    cargar(document.getElementById('chk-bajo-stock').checked);
  };

  window.abrirMovimiento = function(id, name) {
    document.getElementById('mov-item-id').value = id;
    document.getElementById('mov-item-name').textContent = `Artículo: ${name}`;
    document.getElementById('mov-qty').value = '';
    document.getElementById('mov-notes').value = '';
    document.getElementById('modal-mov-error').style.display = 'none';
    document.getElementById('modal-mov').style.display = 'flex';
  };

  document.getElementById('btn-mov-cancel').onclick = () => document.getElementById('modal-mov').style.display = 'none';

  document.getElementById('btn-mov-save').onclick = async () => {
    const itemId = document.getElementById('mov-item-id').value;
    const errEl = document.getElementById('modal-mov-error');
    const body = {
      movement_type: document.getElementById('mov-type').value,
      quantity: document.getElementById('mov-qty').value,
      notes: document.getElementById('mov-notes').value,
    };
    const res = await fetch(`${api}/inventory/${itemId}/movimientos/`, {
      method: 'POST', headers: { Authorization: `Token ${token}`, 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    if (!res.ok) { const err = await res.json(); errEl.textContent = JSON.stringify(err); errEl.style.display = 'block'; return; }
    document.getElementById('modal-mov').style.display = 'none';
    cargar(document.getElementById('chk-bajo-stock').checked);
  };

  document.getElementById('chk-bajo-stock').addEventListener('change', e => cargar(e.target.checked));
  cargar();
</script>
