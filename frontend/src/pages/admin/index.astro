---
import AdminLayout from '../../layouts/AdminLayout.astro';
const api = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000/api';
---

<AdminLayout title="Dashboard | Gustos y Sabores">
  <div class="kpi-grid" id="kpi-grid">
    <div class="kpi-card"><span class="kpi-label">Cargando...</span></div>
  </div>

  <div class="dashboard-panels-grid">
    <div class="admin-card">
      <div class="section-header">
        <span class="section-title">Pedidos por estado</span>
      </div>
      <div class="panel-chart-container">
        <div id="orders-donut" class="donut-chart"></div>
        <div id="orders-status-list" class="status-list-col"></div>
      </div>
    </div>
    <div class="admin-card">
      <div class="section-header">
        <span class="section-title">Reservas por estado</span>
      </div>
      <div class="panel-chart-container">
        <div id="reservations-donut" class="donut-chart"></div>
        <div id="reservas-status-list" class="status-list-col"></div>
      </div>
    </div>
  </div>

  <style>
    .dashboard-panels-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    .panel-chart-container {
      display: flex;
      gap: 2rem;
      align-items: center;
      justify-content: space-around;
      flex-wrap: wrap;
    }

    .status-list-col {
      flex: 1;
      min-width: 180px;
    }

    /* Donut Chart styles */
    .donut-chart {
      display: grid;
      place-items: center;
      min-height: 160px;
      flex-shrink: 0;
    }

    .donut {
      display: grid;
      place-items: center;
      width: 140px;
      height: 140px;
      border-radius: 50%;
      box-shadow: inset 0 0 0 22px white, 0 8px 24px rgba(0, 63, 53, 0.08);
      position: relative;
    }

    .donut.empty {
      background: rgba(0, 63, 53, 0.12);
    }

    .donut span {
      display: grid;
      place-items: center;
      width: 76px;
      height: 76px;
      border-radius: 50%;
      color: var(--jade);
      background: white;
      font-size: 1.8rem;
      font-weight: 900;
    }

    @media (max-width: 860px) {
      .dashboard-panels-grid {
        grid-template-columns: 1fr;
      }
      .panel-chart-container {
        flex-direction: column;
        gap: 1rem;
      }
    }
  </style>
</AdminLayout>

<script define:vars={{ api }}>
  const token = localStorage.getItem('gustos_token');
  const fmt = new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN' });
  const palette = ['#003f35', '#00725f', '#e3962e', '#ac3c24', '#6f8f87'];

  const STATUS_LABELS = {
    pending: 'Pendiente', preparing: 'En preparación', ready: 'Listo',
    delivered: 'Entregado', cancelled: 'Cancelado',
    confirmed: 'Confirmada',
  };

  function renderDonut(target, data) {
    const entries = Object.entries(data || {});
    const total = entries.reduce((sum, [, value]) => sum + value, 0);
    if (!total) {
      const donut = document.createElement('div');
      donut.className = 'donut empty';
      const span = document.createElement('span');
      span.textContent = '0';
      donut.append(span);
      target.replaceChildren(donut);
      return;
    }
    let cursor = 0;
    const stops = entries.map(([, value], index) => {
      const start = cursor;
      cursor += (value / total) * 100;
      return `${palette[index % palette.length]} ${start}% ${cursor}%`;
    }).join(', ');
    const donut = document.createElement('div');
    donut.className = 'donut';
    donut.style.background = `conic-gradient(${stops})`;
    const span = document.createElement('span');
    span.textContent = String(total);
    donut.append(span);
    target.replaceChildren(donut);
  }

  async function load() {
    const res = await fetch(`${api}/dashboard/kpis/`, {
      headers: { Authorization: `Token ${token}` },
    });
    if (!res.ok) return;
    const d = await res.json();

    document.getElementById('kpi-grid').innerHTML = `
      <div class="kpi-card">
        <span class="kpi-label">Total pedidos</span>
        <span class="kpi-value">${d.orders_total}</span>
      </div>
      <div class="kpi-card">
        <span class="kpi-label">Ingresos</span>
        <span class="kpi-value" style="font-size:1.5rem">${fmt.format(d.orders_revenue)}</span>
      </div>
      <div class="kpi-card">
        <span class="kpi-label">Total reservas</span>
        <span class="kpi-value">${d.reservations_total}</span>
      </div>
      <div class="kpi-card">
        <span class="kpi-label">Platos disponibles</span>
        <span class="kpi-value">${d.available_dishes}</span>
        <span class="kpi-sub">de ${d.dishes_total} en total</span>
      </div>
    `;

    // Renderizar gráficos
    renderDonut(document.getElementById('orders-donut'), d.orders_by_status);
    renderDonut(document.getElementById('reservations-donut'), d.reservations_by_status);

    // Listas con indicadores de color al costado
    document.getElementById('orders-status-list').innerHTML =
      Object.entries(d.orders_by_status).map(([k, v], index) =>
        `<div style="display:flex;justify-content:space-between;align-items:center;padding:0.5rem 0;border-bottom:1px solid var(--line)">
          <span style="display:flex;align-items:center;gap:0.4rem">
            <i style="width:0.6rem;height:0.6rem;border-radius:50%;background:${palette[index % palette.length]};display:inline-block"></i>
            ${STATUS_LABELS[k] ?? k}
          </span>
          <strong>${v}</strong>
        </div>`
      ).join('') || '<p style="color:var(--ink-soft);font-size:0.9rem">Sin datos aún</p>';

    document.getElementById('reservas-status-list').innerHTML =
      Object.entries(d.reservations_by_status).map(([k, v], index) =>
        `<div style="display:flex;justify-content:space-between;align-items:center;padding:0.5rem 0;border-bottom:1px solid var(--line)">
          <span style="display:flex;align-items:center;gap:0.4rem">
            <i style="width:0.6rem;height:0.6rem;border-radius:50%;background:${palette[index % palette.length]};display:inline-block"></i>
            ${STATUS_LABELS[k] ?? k}
          </span>
          <strong>${v}</strong>
        </div>`
      ).join('') || '<p style="color:var(--ink-soft);font-size:0.9rem">Sin datos aún</p>';
  }

  load();
</script>
