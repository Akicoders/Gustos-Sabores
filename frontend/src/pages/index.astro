---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gustos y Sabores | Pedidos y reservas">
  <section class="page hero home-hero">
    <div>
      <span class="eyebrow">Cocina criolla norteña</span>
      <h1>Gustos auténticos, sabores que inspiran.</h1>
      <p>
        Desde Chiclayo para tu mesa: una experiencia digital para explorar el menú, registrar pedidos y reservar sin esperas.
      </p>
      <div class="actions">
        <a class="button" href="/menu">Ver menu</a>
        <a class="button secondary" href="/reservas">Reservar mesa</a>
      </div>
    </div>
    <aside class="hero-card">
      <div class="photo photo-main" aria-hidden="true"></div>
      <div class="address-card">
        <strong>Av. Miguel Grau N° 11</strong>
        <span>Chiclayo, Perú</span>
        <span>Tel: 912345678</span>
      </div>
    </aside>
  </section>

  <section class="page">
    <span class="eyebrow">Nuestra propuesta</span>
    <div class="feature-grid">
      <article class="card value-card"><h3>Increíble comida</h3><p>Platos criollos preparados con identidad local, frescura y sabor norteño.</p></article>
      <article class="card value-card"><h3>Producto local</h3><p>Ingredientes y recetas pensadas para sostener la experiencia del restaurante.</p></article>
      <article class="card value-card"><h3>Experiencia única</h3><p>Pedidos y reservas organizados desde una interfaz simple para el cliente.</p></article>
    </div>
  </section>

  <section class="newsletter">
    <div class="page newsletter-inner">
      <span class="eyebrow inverse">Boletín</span>
      <h2>Recibe novedades en descuentos, eventos y promociones</h2>
      <form class="subscribe" onsubmit="event.preventDefault()">
        <label>Email<input type="email" placeholder="cliente@email.com" /></label>
        <button type="submit">Suscríbete</button>
      </form>
    </div>
  </section>
</Layout>

<style>
  .home-hero {
    position: relative;
    min-height: 760px;
  }

  .home-hero::before,
  .home-hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    border: 18px solid var(--jade-3);
    opacity: 0.9;
  }

  .home-hero::before {
    width: 42%;
    height: 40%;
    right: 3%;
    top: 8%;
    border-left: 0;
    border-bottom: 0;
  }

  .home-hero::after {
    width: 48%;
    height: 36%;
    left: 2%;
    bottom: 12%;
    border-right: 0;
    border-top: 0;
  }

  .hero-card {
    position: relative;
    display: grid;
    gap: 1rem;
  }

  .photo {
    min-height: 360px;
    border-radius: 18px;
    background:
      linear-gradient(135deg, rgba(0, 63, 53, 0.24), rgba(0, 63, 53, 0.02)),
      url('https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=1200&q=80') center/cover;
    box-shadow: 0 28px 70px rgba(0, 63, 53, 0.24);
  }

  .address-card {
    position: absolute;
    left: -12%;
    bottom: 12%;
    display: grid;
    gap: 0.25rem;
    width: min(360px, 80%);
    padding: 1.25rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: 0 22px 50px rgba(0, 63, 53, 0.18);
    font-family: ui-sans-serif, system-ui, sans-serif;
  }

  .address-card strong { color: var(--jade); font-size: 1.05rem; }
  .address-card span { color: var(--ink-soft); }

  .value-card {
    text-align: center;
    border-top: 6px solid var(--jade);
  }

  .newsletter {
    color: white;
    background:
      radial-gradient(circle at 50% 110%, rgba(0, 114, 95, 0.35), transparent 25rem),
      var(--jade);
  }

  .newsletter-inner {
    text-align: center;
  }

  .newsletter h2 {
    width: min(840px, 100%);
    margin: 0 auto 1.5rem;
    text-transform: uppercase;
  }

  .newsletter p,
  .newsletter label { color: rgba(255, 255, 255, 0.82); }

  .inverse {
    color: white;
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.18);
  }

  .subscribe {
    display: flex;
    align-items: end;
    justify-content: center;
    gap: 0.8rem;
    max-width: 620px;
    margin: 0 auto;
  }

  .subscribe label { flex: 1; text-align: left; }
  .subscribe button { background: var(--jade-3); }

  @media (max-width: 760px) {
    .home-hero { min-height: auto; }
    .address-card { position: static; width: 100%; }
    .subscribe { align-items: stretch; flex-direction: column; }
  }
</style>
