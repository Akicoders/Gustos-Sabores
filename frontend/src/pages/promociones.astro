---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Promociones | Gustos y Sabores">
  <section class="promos-page page">
    <div data-reveal>
      <span class="eyebrow">PROMOCIONES</span>
      <h1>Combos para compartir</h1>
      <p>Combos destacados que agregan el plato real asociado a tu carrito, con el precio vigente de la carta.</p>
    </div>

    <div class="promo-grid" data-reveal-group>
      <article class="promo-card" data-dish-name="Arroz con pato" data-promo-name="Combo Norteño" data-reveal>
        <img src="https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=900&q=80" alt="Combo norteño" loading="lazy" />
        <div>
          <h2>Combo Norteño</h2>
          <p>Arroz con pato + bebida tradicional.</p>
          <strong data-promo-price>Precio real de carta</strong>
          <button type="button">Agregar plato asociado</button>
        </div>
      </article>

      <article class="promo-card" data-dish-name="Lomo saltado" data-promo-name="Lomo para dos" data-reveal>
        <img src="https://images.unsplash.com/photo-1529692236671-f1f6cf9683ba?auto=format&fit=crop&w=900&q=80" alt="Lomo para dos" loading="lazy" />
        <div>
          <h2>Lomo para dos</h2>
          <p>Lomo saltado familiar con refresco.</p>
          <strong data-promo-price>Precio real de carta</strong>
          <button type="button">Agregar plato asociado</button>
        </div>
      </article>

      <article class="promo-card" data-dish-name="Ceviche clasico" data-promo-name="Ceviche y chicha" data-reveal>
        <img src="https://images.unsplash.com/photo-1626200419199-391ae4be7a41?auto=format&fit=crop&w=900&q=80" alt="Ceviche y chicha" loading="lazy" />
        <div>
          <h2>Ceviche y chicha</h2>
          <p>Ceviche clásico + chicha morada.</p>
          <strong data-promo-price>Precio real de carta</strong>
          <button type="button">Agregar plato asociado</button>
        </div>
      </article>
    </div>

    <p id="promo-status" class="status" aria-live="polite"></p>
    <a class="button" href="/pedidos">Ir al pago</a>
  </section>
</Layout>

<script>
  import { addToCart } from '../scripts/cart';
  import { formatMoney } from '../scripts/format';
  import { apiFetch } from '../scripts/api';
  import { pulse } from '../scripts/dom';

  interface Dish {
    id: number;
    name: string;
    price: number | string;
    image_url?: string;
  }

  const status = document.querySelector<HTMLElement>('#promo-status');
  const grid = document.querySelector<HTMLElement>('.promo-grid');
  let dishes: Dish[] = [];

  function setStatus(message: string, kind: 'error' | 'success' | '' = '') {
    if (!status) return;
    status.textContent = message;
    status.classList.toggle('is-error', kind === 'error');
    status.classList.toggle('is-success', kind === 'success');
  }

  function findDish(name: string | undefined): Dish | undefined {
    return dishes.find((item) => item.name === name);
  }

  async function loadDishes() {
    try {
      dishes = await apiFetch<Dish[]>('/menu/dishes/');
    } catch {
      setStatus('No se pudo cargar el menú para promociones.', 'error');
      return;
    }
    document.querySelectorAll<HTMLElement>('[data-dish-name]').forEach((card) => {
      const dish = findDish(card.dataset.dishName);
      const price = card.querySelector<HTMLElement>('[data-promo-price]');
      const button = card.querySelector<HTMLButtonElement>('button');
      if (!dish) {
        if (price) price.textContent = 'No disponible en carta';
        if (button) button.disabled = true;
        return;
      }
      if (price) price.textContent = `${formatMoney(Number(dish.price))} en carta`;
    });
  }

  grid?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-dish-name] button');
    if (!button) return;
    const card = button.closest<HTMLElement>('[data-dish-name]');
    const dish = findDish(card?.dataset.dishName);
    if (!dish) {
      setStatus('No se pudo encontrar el plato de esta promoción en la carta.', 'error');
      return;
    }
    addToCart(dish);
    pulse(button);
    setStatus(
      `${card?.dataset.promoName}: se agregó ${dish.name} a tu carrito (${formatMoney(Number(dish.price))}).`,
      'success',
    );
  });

  loadDishes();
</script>

<style>
  .promos-page { text-align: center; }
  .promos-page > div > p { max-width: 620px; margin-inline: auto; }

  .promo-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 2rem 0;
    text-align: left;
  }

  .promo-card {
    display: grid;
    overflow: hidden;
    background: white;
    border: 1px solid var(--line);
    box-shadow: 0 18px 55px rgba(0, 63, 53, 0.1);
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }

  .promo-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 26px 70px rgba(0, 63, 53, 0.18);
  }

  .promo-card img {
    width: 100%;
    height: 190px;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .promo-card:hover img { transform: scale(1.06); }

  .promo-card div {
    display: grid;
    gap: 0.7rem;
    padding: 1rem;
  }

  .promo-card h2 { color: var(--jade); font-size: 1.45rem; }
  .promo-card p { margin: 0; }
  .promo-card strong { color: var(--jade-2); font-size: 1.35rem; }
  .promo-card button { border-radius: 0; }

  @media (max-width: 850px) {
    .promo-grid { grid-template-columns: 1fr; }
  }
</style>
