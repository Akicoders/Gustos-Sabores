---
import Layout from '../layouts/Layout.astro';
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000/api';
---

<Layout title="Login | Gustos y Sabores">
  <section class="page hero">
    <div>
      <span class="eyebrow">Clientes</span>
      <h1>Acceso rapido</h1>
      <p>Autenticacion por token para que el cliente pueda consultar pedidos y reservas en siguientes incrementos.</p>
    </div>
    <form id="login-form" class="panel form-grid" data-api={apiUrl}>
      <label class="full">Usuario<input name="username" required /></label>
      <label class="full">Contrasena<input name="password" type="password" required /></label>
      <button type="submit">Iniciar sesion</button>
      <p id="login-status" class="status full"></p>
    </form>
  </section>
</Layout>

<script>
  import { apiFetch, ApiError } from '../scripts/api';

  interface LoginResponse {
    token: string;
    user: { full_name?: string; username: string; role: string };
  }

  const form = document.querySelector<HTMLFormElement>('#login-form');
  const status = document.querySelector<HTMLParagraphElement>('#login-status');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  function setStatus(message: string, kind: 'error' | 'success' | '' = '') {
    if (!status) return;
    status.textContent = message;
    status.classList.toggle('is-error', kind === 'error');
    status.classList.toggle('is-success', kind === 'success');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const payload = Object.fromEntries(new FormData(form).entries());

    if (submitButton) submitButton.disabled = true;
    setStatus('Verificando credenciales...');

    try {
      const data = await apiFetch<LoginResponse>('/auth/login/', {
        method: 'POST',
        body: JSON.stringify(payload),
      });
      localStorage.setItem('gustos_token', data.token);
      localStorage.setItem('gustos_user', JSON.stringify(data.user));
      setStatus(`Sesión iniciada como ${data.user.full_name || data.user.username}. Redirigiendo...`, 'success');

      const target = data.user.role === 'admin' || data.user.role === 'staff' ? '/admin' : '/';
      setTimeout(() => { window.location.href = target; }, 1000);
    } catch (error) {
      const message =
        error instanceof ApiError && error.status === 400
          ? 'Usuario o contraseña incorrectos.'
          : error instanceof ApiError
            ? error.message
            : 'No se pudo iniciar sesión.';
      setStatus(message, 'error');
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
