---
return Astro.redirect('/admin');
---

<Layout title="Dashboard KPI | Gustos y Sabores">
  <section class="dashboard-page page">
    <span class="eyebrow">Dashboard KPI</span>
    <h1>Indicadores del sistema</h1>
    <p>Información calculada desde la base de datos del MVP: pedidos, reservas, platos e ingresos.</p>

    <div id="kpi-grid" class="kpi-grid" data-api={apiUrl}>
      <article class="kpi-card"><span>Pedidos</span><strong id="orders-total">0</strong></article>
      <article class="kpi-card"><span>Ingresos</span><strong id="orders-revenue">S/ 0.00</strong></article>
      <article class="kpi-card"><span>Reservas</span><strong id="reservations-total">0</strong></article>
      <article class="kpi-card"><span>Platos disponibles</span><strong id="available-dishes">0</strong></article>
    </div>

    <div class="dashboard-panels">
      <section class="dash-panel">
        <h2>Pedidos por estado</h2>
        <div id="orders-donut" class="donut-chart"></div>
        <div id="orders-legend" class="chart-legend"></div>
        <div id="orders-status"></div>
      </section>
      <section class="dash-panel">
        <h2>Reservas por estado</h2>
        <div id="reservations-donut" class="donut-chart"></div>
        <div id="reservations-legend" class="chart-legend"></div>
        <div id="reservations-status"></div>
      </section>
      <section class="dash-panel full-panel">
        <h2>Menú por categoría</h2>
        <div id="menu-columns" class="column-chart"></div>
        <div id="menu-category"></div>
      </section>
    </div>
    <p id="dashboard-status" class="status" aria-live="polite">Cargando KPIs...</p>
  </section>
</Layout>

<script>
  const grid = document.querySelector('#kpi-grid');
  const api = grid.dataset.api;
  const status = document.querySelector('#dashboard-status');
  const money = new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN' });
  const palette = ['#003f35', '#00725f', '#e3962e', '#ac3c24', '#6f8f87'];
  const demoKPIs = {
    orders_total: 24,
    orders_revenue: 1460,
    orders_by_status: { pending: 6, preparing: 5, ready: 4, delivered: 9 },
    reservations_total: 12,
    reservations_by_status: { pending: 4, confirmed: 7, cancelled: 1 },
    dishes_total: 18,
    available_dishes: 15,
    menu_by_category: { Entradas: 5, Fondos: 8, Bebidas: 5 },
  };

  function createTextElement(tag, text, className) {
    const element = document.createElement(tag);
    if (className) element.className = className;
    element.textContent = text;
    return element;
  }

  function renderBars(target, data) {
    const entries = Object.entries(data || {});
    if (!entries.length) {
      target.replaceChildren(createTextElement('p', 'Sin datos registrados.'));
      return;
    }
    const max = Math.max(...entries.map(([, value]) => value), 1);
    target.replaceChildren(...entries.map(([label, value]) => {
      const row = document.createElement('div');
      row.className = 'bar-row';
      const bar = document.createElement('div');
      bar.className = 'bar';
      const fill = document.createElement('i');
      fill.style.width = `${(Number(value) / max) * 100}%`;
      bar.append(fill);
      row.append(createTextElement('span', label), bar, createTextElement('strong', String(value)));
      return row;
    }));
  }

  function renderLegend(target, data) {
    const entries = Object.entries(data || {});
    target.replaceChildren(...entries.map(([label, value], index) => {
      const item = document.createElement('span');
      const swatch = document.createElement('i');
      swatch.style.background = palette[index % palette.length];
      item.append(swatch, document.createTextNode(`${label}: ${value}`));
      return item;
    }));
  }

  function renderDonut(target, data) {
    const entries = Object.entries(data || {});
    const total = entries.reduce((sum, [, value]) => sum + value, 0);
    if (!total) {
      const donut = document.createElement('div');
      donut.className = 'donut empty';
      donut.append(createTextElement('span', '0'));
      target.replaceChildren(donut);
      return;
    }
    let cursor = 0;
    const stops = entries.map(([, value], index) => {
      const start = cursor;
      cursor += (value / total) * 100;
      return `${palette[index % palette.length]} ${start}% ${cursor}%`;
    }).join(', ');
    const donut = document.createElement('div');
    donut.className = 'donut';
    donut.style.background = `conic-gradient(${stops})`;
    donut.append(createTextElement('span', String(total)));
    target.replaceChildren(donut);
  }

  function renderColumns(target, data) {
    const entries = Object.entries(data || {});
    const max = Math.max(...entries.map(([, value]) => value), 1);
    target.replaceChildren(...entries.map(([label, value]) => {
      const item = document.createElement('div');
      item.className = 'column-item';
      const track = document.createElement('div');
      track.className = 'column-track';
      const fill = document.createElement('i');
      fill.style.height = `${Math.max((Number(value) / max) * 100, 8)}%`;
      track.append(fill);
      item.append(track, createTextElement('strong', String(value)), createTextElement('span', label));
      return item;
    }));
  }

  function renderKPIs(data, sourceMessage) {
    document.querySelector('#orders-total').textContent = data.orders_total;
    document.querySelector('#orders-revenue').textContent = money.format(Number(data.orders_revenue));
    document.querySelector('#reservations-total').textContent = data.reservations_total;
    document.querySelector('#available-dishes').textContent = `${data.available_dishes}/${data.dishes_total}`;
    renderDonut(document.querySelector('#orders-donut'), data.orders_by_status);
    renderDonut(document.querySelector('#reservations-donut'), data.reservations_by_status);
    renderLegend(document.querySelector('#orders-legend'), data.orders_by_status);
    renderLegend(document.querySelector('#reservations-legend'), data.reservations_by_status);
    renderColumns(document.querySelector('#menu-columns'), data.menu_by_category);
    renderBars(document.querySelector('#orders-status'), data.orders_by_status);
    renderBars(document.querySelector('#reservations-status'), data.reservations_by_status);
    renderBars(document.querySelector('#menu-category'), data.menu_by_category);
    status.textContent = sourceMessage;
  }

  async function loadKPIs() {
    try {
      const response = await fetch(`${api}/dashboard/kpis/`);
      if (response.status === 401 || response.status === 403) {
        renderKPIs(demoKPIs, 'API KPI protegida. Mostrando datos demo del dashboard publico.');
        return;
      }
      if (!response.ok) throw new Error('No se pudo cargar KPI');
      const data = await response.json();
      renderKPIs(data, 'KPIs actualizados desde la base de datos.');
    } catch (error) {
      status.textContent = 'No se pudo conectar con la API de KPIs.';
    }
  }

  loadKPIs();
</script>

<style>
  .dashboard-page h1 { color: var(--jade); }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 2rem 0;
  }

  .kpi-card,
  .dash-panel {
    padding: 1.2rem;
    background: white;
    border: 1px solid var(--line);
    box-shadow: 0 18px 45px rgba(0, 63, 53, 0.08);
  }

  .kpi-card span {
    color: var(--ink-soft);
    font-size: 0.85rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .kpi-card strong {
    display: block;
    margin-top: 0.65rem;
    color: var(--jade);
    font-size: clamp(1.8rem, 4vw, 3rem);
  }

  .dashboard-panels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .full-panel { grid-column: 1 / -1; }
  .dash-panel h2 { color: var(--jade); font-size: 1.45rem; margin-bottom: 1rem; }

  .donut-chart {
    display: grid;
    place-items: center;
    min-height: 180px;
    margin-bottom: 1rem;
  }

  .donut {
    display: grid;
    place-items: center;
    width: 156px;
    height: 156px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 28px rgba(255, 255, 255, 0.78), 0 18px 40px rgba(0, 63, 53, 0.14);
  }

  .donut.empty { background: rgba(0, 63, 53, 0.12); }

  .donut span {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    color: var(--jade);
    background: white;
    font-size: 2rem;
    font-weight: 900;
  }

  .chart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.8rem;
    margin-bottom: 1rem;
    color: var(--ink-soft);
    font-weight: 800;
  }

  .chart-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .chart-legend i {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 999px;
  }

  .column-chart {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: end;
    min-height: 220px;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: rgba(0, 63, 53, 0.04);
  }

  .column-item {
    display: grid;
    gap: 0.45rem;
    justify-items: center;
    color: var(--ink-soft);
    font-weight: 900;
    text-align: center;
  }

  .column-track {
    position: relative;
    display: flex;
    align-items: end;
    width: 100%;
    max-width: 82px;
    height: 150px;
    overflow: hidden;
    background: rgba(0, 63, 53, 0.1);
  }

  .column-track i {
    display: block;
    width: 100%;
    background: linear-gradient(180deg, var(--jade-3), var(--jade));
  }

  .bar-row {
    display: grid;
    grid-template-columns: 110px 1fr 44px;
    gap: 0.7rem;
    align-items: center;
    margin-bottom: 0.8rem;
    color: var(--ink-soft);
    font-weight: 800;
  }

  .bar {
    height: 12px;
    overflow: hidden;
    background: rgba(0, 63, 53, 0.1);
  }

  .bar i {
    display: block;
    height: 100%;
    background: var(--jade-3);
  }

  @media (max-width: 860px) {
    .kpi-grid,
    .dashboard-panels { grid-template-columns: 1fr; }
    .full-panel { grid-column: auto; }
  }
</style>
