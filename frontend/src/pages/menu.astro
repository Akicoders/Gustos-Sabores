---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Menú | Gustos y Sabores">
  <section class="menu-page page">
    <div class="corner corner-top" aria-hidden="true"></div>
    <div class="menu-title" data-reveal>
      <span class="eyebrow">MENÚ</span>
      <h1>Menú de almuerzo</h1>
      <p>Selección de tu menú. Puedes personalizarla a tu gusto.</p>
    </div>

    <div class="menu-layout">
      <aside class="category-rail" aria-label="Categorias">
        <a href="#entradas">Entradas</a>
        <a href="#principales">Principales</a>
        <a href="#bebidas">Bebidas</a>
      </aside>

      <div class="menu-content">
        <section id="entradas" class="menu-section">
          <h2>Entradas</h2>
          <div id="entradas-grid" class="menu-list"></div>
        </section>
        <section id="principales" class="menu-section">
          <h2>Principales</h2>
          <div id="principales-grid" class="menu-list"></div>
        </section>
        <section id="bebidas" class="menu-section">
          <h2>Bebidas</h2>
          <div id="bebidas-grid" class="menu-list"></div>
        </section>
        <p id="menu-status" class="status" aria-live="polite">Cargando menú...</p>
      </div>

      <aside class="cart-summary">
        <h3>RESUMEN DE CARRITO</h3>
        <div id="cart-items" class="cart-items" aria-live="polite"></div>
        <strong>Tarifa total</strong>
        <span id="cart-total" class="price">S/ 0.00</span>
        <a class="button" href="/pedidos">Comprar</a>
        <button id="clear-cart" class="button secondary" type="button">Vaciar carrito</button>
      </aside>
    </div>
  </section>
</Layout>

<script>
  import {
    getCart, addToCart, changeQuantity, clearCart, cartTotal, CART_EVENT, type CartItem,
  } from '../scripts/cart';
  import { formatMoney } from '../scripts/format';
  import { apiFetch } from '../scripts/api';
  import { createTextElement, pulse, revealOnScroll } from '../scripts/dom';

  interface Dish {
    id: number;
    name: string;
    price: number | string;
    description?: string;
    category?: string;
    image_url?: string;
  }

  type GroupKey = 'entradas' | 'fondos' | 'bebidas';

  const FALLBACK_IMAGE =
    'https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=900&q=80';

  const status = document.querySelector<HTMLElement>('#menu-status');
  const menuContent = document.querySelector<HTMLElement>('.menu-content');
  const cartItems = document.querySelector<HTMLElement>('#cart-items');
  const cartTotalEl = document.querySelector<HTMLElement>('#cart-total');
  const clearCartButton = document.querySelector<HTMLButtonElement>('#clear-cart');

  const groups: Record<GroupKey, HTMLElement | null> = {
    entradas: document.querySelector('#entradas-grid'),
    fondos: document.querySelector('#principales-grid'),
    bebidas: document.querySelector('#bebidas-grid'),
  };

  const dishesById = new Map<number, Dish>();

  function normalizeCategory(category: unknown): GroupKey {
    const text = String(category ?? '').toLowerCase();
    if (text.includes('entrada')) return 'entradas';
    if (text.includes('bebida')) return 'bebidas';
    return 'fondos';
  }

  function showSkeletons() {
    (Object.values(groups) as (HTMLElement | null)[]).forEach((group) => {
      if (!group) return;
      const placeholders = Array.from({ length: 2 }, () => {
        const card = document.createElement('div');
        card.className = 'menu-dish skeleton-dish';
        card.innerHTML =
          '<div class="skeleton skeleton-card"></div>' +
          '<div><div class="skeleton skeleton-line" style="width:60%"></div>' +
          '<div class="skeleton skeleton-line" style="width:90%"></div></div>' +
          '<div class="skeleton skeleton-line" style="width:70px;height:2rem"></div>';
        return card;
      });
      group.replaceChildren(...placeholders);
    });
  }

  function createDishCard(dish: Dish): HTMLElement {
    const article = document.createElement('article');
    article.className = 'menu-dish';
    article.setAttribute('data-reveal', '');

    const img = document.createElement('img');
    img.src = dish.image_url || FALLBACK_IMAGE;
    img.alt = dish.name;
    img.loading = 'lazy';
    img.addEventListener('error', () => { img.src = FALLBACK_IMAGE; });

    const body = document.createElement('div');
    body.append(
      createTextElement('h3', dish.name),
      createTextElement('p', dish.description || 'Plato disponible del restaurante.'),
    );

    const actions = document.createElement('div');
    actions.className = 'dish-actions';
    actions.append(createTextElement('strong', formatMoney(Number(dish.price))));
    const button = document.createElement('button');
    button.type = 'button';
    button.dataset.dishId = String(dish.id);
    button.textContent = 'Agregar';
    actions.append(button);

    article.append(img, body, actions);
    return article;
  }

  function renderCart() {
    if (!cartItems || !cartTotalEl) return;
    const cart = getCart();
    if (!cart.length) {
      cartItems.replaceChildren(createTextElement('p', 'Aún no agregas platos.', 'cart-empty'));
      cartTotalEl.textContent = formatMoney(0);
      return;
    }
    cartItems.replaceChildren(
      ...cart.map((item: CartItem) => {
        const line = document.createElement('div');
        line.className = 'cart-line';
        line.append(createTextElement('span', `${item.name} - x${item.quantity}`));

        const controls = document.createElement('div');
        controls.className = 'cart-controls';
        const minus = document.createElement('button');
        minus.type = 'button';
        minus.dataset.cartMinus = String(item.id);
        minus.textContent = '-';
        minus.setAttribute('aria-label', `Quitar ${item.name}`);
        const plus = document.createElement('button');
        plus.type = 'button';
        plus.dataset.cartPlus = String(item.id);
        plus.textContent = '+';
        plus.setAttribute('aria-label', `Agregar ${item.name}`);
        controls.append(minus, plus);
        line.append(controls);
        return line;
      }),
    );
    cartTotalEl.textContent = formatMoney(cartTotal(cart));
  }

  async function loadMenu() {
    showSkeletons();
    try {
      const dishes = await apiFetch<Dish[]>('/menu/dishes/');
      dishesById.clear();
      (Object.values(groups) as (HTMLElement | null)[]).forEach((group) => group?.replaceChildren());
      dishes.forEach((dish) => {
        dishesById.set(Number(dish.id), dish);
        const target = groups[normalizeCategory(dish.category)];
        target?.append(createDishCard(dish));
      });
      if (status) status.textContent = `${dishes.length} platos disponibles.`;
      revealOnScroll('.menu-dish[data-reveal]');
    } catch {
      (Object.values(groups) as (HTMLElement | null)[]).forEach((group) => group?.replaceChildren());
      if (status) {
        status.textContent = 'No se pudo conectar con la API. Revisa que el backend esté corriendo.';
        status.classList.add('is-error');
      }
    }
  }

  // Event delegation: add-to-cart for any current or future dish button
  menuContent?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-dish-id]');
    if (!button) return;
    const dish = dishesById.get(Number(button.dataset.dishId));
    if (!dish) return;
    addToCart(dish);
    pulse(button);
    button.textContent = 'Agregado ✓';
    window.setTimeout(() => { button.textContent = 'Agregar'; }, 900);
  });

  cartItems?.addEventListener('click', (event) => {
    const minus = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-cart-minus]');
    const plus = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-cart-plus]');
    if (minus) changeQuantity(Number(minus.dataset.cartMinus), -1);
    if (plus) changeQuantity(Number(plus.dataset.cartPlus), 1);
  });

  clearCartButton?.addEventListener('click', () => clearCart());
  document.addEventListener(CART_EVENT, renderCart);

  renderCart();
  loadMenu();
</script>

<style>
  .menu-page {
    position: relative;
    padding-top: 4rem;
  }

  .corner {
    position: absolute;
    top: 1.2rem;
    right: 1rem;
    width: min(420px, 44vw);
    height: 260px;
    border-top: 18px solid var(--jade-3);
    border-right: 18px solid var(--jade-3);
  }

  .menu-title {
    position: relative;
    z-index: 1;
    width: min(640px, 100%);
    margin: 0 auto 2.5rem;
    text-align: center;
  }

  .menu-layout {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) 250px;
    gap: 1.2rem;
    align-items: start;
  }

  .category-rail,
  .cart-summary {
    position: sticky;
    top: 1rem;
    display: grid;
    gap: 0.8rem;
    padding: 1rem;
    background: white;
    border: 1px solid var(--line);
    box-shadow: 0 16px 45px rgba(0, 63, 53, 0.08);
  }

  .category-rail a {
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--jade);
    font-weight: 900;
    text-transform: uppercase;
    transition: color 0.18s ease, padding-left 0.18s ease;
  }

  .category-rail a:hover {
    color: var(--jade-3);
    padding-left: 0.4rem;
  }

  .menu-section {
    margin-bottom: 2rem;
  }

  .menu-section h2 {
    margin-bottom: 1rem;
    color: var(--jade);
    font-size: clamp(1.5rem, 4vw, 2.4rem);
  }

  .menu-list {
    display: grid;
    gap: 0.8rem;
  }

  .cart-summary h3 { color: var(--jade); }
  .cart-summary .button { text-align: center; }

  @media (max-width: 900px) {
    .menu-layout { grid-template-columns: 1fr; }
    .category-rail, .cart-summary { position: static; }
  }
</style>

<style is:global>
  .menu-dish {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr) max-content;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
    overflow: hidden;
    background: white;
    border: 1px solid var(--line);
    border-left: 8px solid var(--jade);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-left-color 0.2s ease;
  }

  .menu-dish:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px rgba(0, 63, 53, 0.14);
    border-left-color: var(--accent);
  }

  .menu-dish img {
    display: block;
    width: 132px;
    height: 104px;
    object-fit: cover;
    object-position: center;
    border-radius: 4px;
    box-shadow: 0 12px 26px rgba(0, 63, 53, 0.12);
    transition: transform 0.3s ease;
  }

  .menu-dish:hover img { transform: scale(1.05); }

  .skeleton-dish { pointer-events: none; border-left-color: var(--line); }
  .skeleton-dish:hover { transform: none; box-shadow: none; }

  .menu-dish h3 { margin-bottom: 0.35rem; }
  .menu-dish p { margin: 0; overflow-wrap: anywhere; }
  .menu-dish strong { color: var(--jade-2); white-space: nowrap; }

  .dish-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    min-width: 110px;
  }

  .dish-actions button {
    border-radius: 6px;
    padding: 0.5rem 1rem;
    box-shadow: none;
    font-size: 0.9rem;
    width: 100%;
  }

  .cart-items { display: grid; gap: 0.7rem; }
  .cart-line {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.9rem;
  }

  .cart-controls { display: flex; gap: 0.4rem; }
  .cart-controls button {
    border-radius: 0;
    padding: 0.45rem 0.65rem;
    box-shadow: none;
  }
  .cart-empty { margin: 0; font-size: 0.9rem; }

  @media (max-width: 900px) {
    .menu-dish { grid-template-columns: 96px 1fr; }
    .menu-dish img { width: 96px; height: 86px; }
    .dish-actions { grid-column: 1 / -1; flex-direction: row; align-items: center; justify-content: space-between; }
  }

  @media (max-width: 560px) {
    .menu-dish { grid-template-columns: 1fr; }
    .menu-dish img { width: 100%; height: 180px; }
    .dish-actions { grid-column: auto; }
  }
</style>
