# ============================================================
# GUSTOS Y SABORES — Variables de Entorno (Desarrollo Local)
# ============================================================
# Copiá este archivo: cp .env.example .env
# Estas variables se cargan automáticamente en Docker Compose
# y en el backend Django cuando corres con runserver.
# ============================================================


# -----------------------------------------------------------
# DJANGO — Configuración base del backend
# -----------------------------------------------------------

# Clave secreta de Django. NUNCA uses este valor en producción.
# Generá una nueva con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-secret-key-change-me

# Modo debug. En producción debe ser False.
DJANGO_DEBUG=True

# Hosts permitidos (separados por coma). El valor "backend" es
# el nombre del servicio en Docker Compose.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Orígenes permitidos para CORS. Debe coincidir con la URL del frontend.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4321


# -----------------------------------------------------------
# BASE DE DATOS — MySQL 8.4
# -----------------------------------------------------------
# Si MYSQL_HOST no está definido, Django usará SQLite automáticamente.
# Para desarrollo con Docker Compose, MYSQL_HOST=mysql (nombre del servicio).

MYSQL_DATABASE=gustos_sabores
MYSQL_USER=gustos_user
MYSQL_PASSWORD=gustos_pass
MYSQL_ROOT_PASSWORD=root_pass
MYSQL_HOST=mysql
MYSQL_PORT=3306


# -----------------------------------------------------------
# FRONTEND — Astro
# -----------------------------------------------------------
# URL base de la API REST. El frontend la usa para todas las peticiones.
# En Docker Compose el frontend llega al backend por el host del navegador,
# por eso apunta a localhost:8000 y no al nombre de servicio interno.

PUBLIC_API_URL=http://localhost:8000/api
